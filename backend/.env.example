# Copy this file to `.env` in the same folder and fill in real values.
# NEVER commit the real .env file. It is already excluded in .gitignore.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/medinexus

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Python ML microservice base URL
ML_SERVICE_URL=http://localhost:8000

# Geoapify (used server-side only, by backend/src/services/geocodingService.js)
# Get your key from https://www.geoapify.com/ and rotate it if it was ever
# pasted into a chat, email, or shared document.
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
