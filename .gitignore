# Environment / secrets — never commit real keys
.env
.env.*
!.env.example
backend/.env
ml-service/.env
frontend/.env

# Node
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
frontend/dist/
frontend/build/

# Python
__pycache__/
*.pyc
.venv/
venv/
ml-service/venv/
ml-service/__pycache__/
*.egg-info/

# Trained model artifacts (large, regenerated by training scripts — not source)
ml-service/models/*.pkl
ml-service/models/*.joblib
ml-service/models/*.txt
!ml-service/models/.gitkeep

# Processed data (regenerated by ETL scripts — raw data is the source of truth)
data/processed/**/*.csv
!data/processed/**/.gitkeep

# Uploaded files (real user data, not source)
backend/uploads/**
!backend/uploads/**/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/
